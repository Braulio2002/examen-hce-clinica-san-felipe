            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"mala\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Ejecute esta peticion 6 veces seguidas: a partir del sexto intento dentro del mismo minuto la API responde 429.\n\nATENCION: agota el limite de login. Espere 60 segundos antes de volver a autenticarse."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 401 o 429 segun el numero de intento', () => {",
                  "  pm.expect([401, 429]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 429) {",
                  "  console.log('Rate limit activo: la proteccion contra fuerza bruta funciona.');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "CORS desde un origen no autorizado",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [{ "key": "Origin", "value": "http://sitio-no-autorizado.com" }],
            "url": { "raw": "{{baseUrl}}/salud", "host": ["{{baseUrl}}"], "path": ["salud"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('No devuelve cabecera CORS para un origen ajeno', () => {",
                  "  pm.expect(pm.response.headers.get('Access-Control-Allow-Origin')).to.be.undefined;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
