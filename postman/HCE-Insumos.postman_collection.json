            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201', () => pm.response.to.have.status(201));",
                  "",
                  "const c = pm.response.json();",
                  "const linea = c.detalle[0];",
                  "",
                  "pm.test('Subtotal = cantidad x precio', () => {",
                  "  pm.expect(linea.subTotal).to.eql(linea.cantidad * linea.precio);",
                  "});",
                  "pm.test('IGV del 18% sobre el subtotal', () => {",
                  "  pm.expect(linea.igv).to.eql(Number((linea.cantidad * linea.precio * 0.18).toFixed(4)));",
                  "});",
                  "pm.test('Total = subtotal + IGV', () => {",
                  "  pm.expect(linea.total).to.eql(Number((linea.subTotal + linea.igv).toFixed(4)));",
                  "});",
                  "",
                  "pm.environment.set('idCompra', c.idCompraCab);"
                ]
