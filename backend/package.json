{
  "name": "hce-insumos-backend",
  "version": "1.0.0",
  "description": "BackEnd de microservicios NestJS para la gestion de insumos medicos HCE - Clinica San Felipe",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build api-gateway && nest build ms-auth && nest build ms-catalogo && nest build ms-inventario",
    "format": "prettier --write .",
    "start:gateway": "nest start api-gateway",
    "start:auth": "nest start ms-auth",
    "start:catalogo": "nest start ms-catalogo",
    "start:inventario": "nest start ms-inventario",
    "start:dev": "concurrently -n gateway,auth,catalogo,inventario -c cyan,green,yellow,magenta \"nest start api-gateway --watch\" \"nest start ms-auth --watch\" \"nest start ms-catalogo --watch\" \"nest start ms-inventario --watch\"",
    "lint": "eslint .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "start:prod:gateway": "node dist/apps/api-gateway/src/infraestructura/main.js",
    "start:prod:auth": "node dist/apps/ms-auth/src/infraestructura/main.js",
    "start:prod:catalogo": "node dist/apps/ms-catalogo/src/infraestructura/main.js",
    "start:prod:inventario": "node dist/apps/ms-inventario/src/infraestructura/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint:fix": "eslint . --fix",
    "lint:strict": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "security:audit": "npm audit --audit-level=high",
    "quality": "npm run format:check && npm run typecheck && npm run lint:strict && npm run test:cov && npm run build"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/microservices": "^11.0.1",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.0.1",
    "helmet": "^8.0.0",
    "mssql": "^11.0.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/mssql": "^9.1.7",
    "@types/node": "^22.10.7",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "concurrently": "^9.1.2",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unicorn": "^72.0.0",
    "globals": "^17.12.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.69.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "apps/*/src/dominio/**/*.ts",
      "apps/*/src/aplicacion/**/*.ts",
      "libs/*/src/dominio/**/*.ts",
      "libs/*/src/aplicacion/**/*.ts",
      "!**/puertos/**",
      "!**/modelos/**",
      "!**/*.spec.ts"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/",
      "<rootDir>/test/"
    ],
    "moduleNameMapper": {
      "^@hce/compartido(|/.*)$": "<rootDir>/libs/compartido/src/$1"
    },
    "coverageThreshold": {
      "global": {
        "statements": 80,
        "branches": 85,
        "functions": 75,
        "lines": 80
      }
    }
  }
}
