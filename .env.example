# =============================================================================
# EXAMEN TECNICO - ESPECIALISTA DESARROLLO HCE
# Variables de entorno del ecosistema. Copie este archivo como .env antes de
# levantar docker-compose:   cp .env.example .env
# =============================================================================

# --- Entorno -----------------------------------------------------------------
NODE_ENV=development

# --- Base de datos SQL Server ------------------------------------------------
# La contrasena debe cumplir la politica de SQL Server: 8+ caracteres con
# mayusculas, minusculas, digitos y simbolos.
MSSQL_SA_PASSWORD=HceDev2026!Clinica
DB_HOST=sqlserver
DB_PORT=1433
DB_NAME=HCE_Insumos
DB_USER=sa
DB_PASSWORD=HceDev2026!Clinica
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true
DB_POOL_MAX=10
DB_POOL_MIN=0
# Puerto publicado en el host para conectarse con SSMS o Azure Data Studio
SQLSERVER_PUERTO_HOST=14330

# --- Seguridad JWT -----------------------------------------------------------
# IMPORTANTE: genere un secreto propio antes de cualquier despliegue real.
#   openssl rand -base64 48
JWT_SECRET=cambie-este-secreto-por-uno-generado-con-openssl-rand-base64-48
# Vigencia estricta de 30 minutos, exigida por el enunciado.
JWT_EXPIRACION_SEGUNDOS=1800
JWT_ISSUER=hce-clinica-san-felipe
JWT_AUDIENCE=hce-frontend
JWT_COOKIE=hce_access_token
# En produccion debe ser true (la cookie solo viaja por HTTPS).
COOKIE_SEGURA=false
BCRYPT_RONDAS=10

# --- API Gateway -------------------------------------------------------------
GATEWAY_PORT=4000
API_PREFIJO=api
# CORS restringido. Separe varios origenes con coma. No se admite "*".
CORS_ORIGENES=http://localhost:3000

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_VENTANA_SEGUNDOS=60
RATE_LIMIT_GENERAL=100
RATE_LIMIT_LOGIN=5

# --- Microservicios (red interna de Docker) ----------------------------------
MS_AUTH_HOST=ms-auth
MS_AUTH_PORT=4001
MS_CATALOGO_HOST=ms-catalogo
MS_CATALOGO_PORT=4002
MS_INVENTARIO_HOST=ms-inventario
MS_INVENTARIO_PORT=4003

# --- FrontEnd ----------------------------------------------------------------
FRONTEND_PUERTO=3000
# URL del Gateway vista desde el navegador del usuario
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# URL del Gateway vista desde el contenedor de Next.js (renderizado en servidor)
API_URL_INTERNA=http://api-gateway:4000/api/v1

# Cuentas de base de datos por microservicio (minimo privilegio).
# Cada servicio solo puede ejecutar sus propios procedimientos: la frontera
# entre microservicios la aplica SQL Server, no el codigo. Las crea el script
# database/06-seguridad-accesos.sql durante el arranque.
# Genera una distinta para cada uno antes de desplegar:
#   openssl rand -base64 24
DB_PASSWORD_AUTH=CAMBIAME_auth
DB_PASSWORD_CATALOGO=CAMBIAME_catalogo
DB_PASSWORD_INVENTARIO=CAMBIAME_inventario

# Muestra las credenciales sembradas en la pantalla de login. Comodo para
# una demo; NUNCA en un despliegue real. Por eso el ejemplo viene apagado.
MOSTRAR_CREDENCIALES_DEMO=false
